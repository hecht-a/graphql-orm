{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{# ================= TOOLBAR ================= #}

{% block toolbar %}
    {% set icon %}
        {{ source('@GraphqlOrm/collector/icon.svg') }}
        <span class="sf-toolbar-value">
            {{ collector.queryCount }}
        </span>
    {% endset %}

    {% set text %}
        {% set validation = collector.schemaValidation %}
        {% set resultCache = collector.resultCacheUsage %}
        {% set secondLevelCache = collector.secondLevelCacheUsage %}
        {% set resultCacheAdapters = collector.cachePools|filter(pool => pool.name == 'result cache')|map(pool => pool.adapter)|join(', ') %}
        {% set secondLevelAdapters = collector.cachePools|filter(pool => pool.name != 'result cache')|map(pool => pool.adapter)|reduce((adapters, adapter) => adapter in adapters ? adapters : adapters|merge([adapter]), [])|join(', ') %}
        <div class="sf-toolbar-info-piece">
            <b>Queries</b>
            <span class="sf-toolbar-status">{{ collector.queryCount }}</span>
        </div>
        {% if (collector.configuration.managers ?? [])|length > 1 %}
            <div class="sf-toolbar-info-piece">
                <b>APIs</b>
                <span>{{ collector.configuration.managers|join(', ') }}</span>
            </div>
        {% endif %}
        <div class="sf-toolbar-info-piece">
            <b>Sent to the API</b>
            <span>{{ collector.queryCount - collector.resultCacheHitCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Different statements</b>
            <span>{{ collector.distinctQueryCount }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Query time</b>
            <span>{{ collector.waitedDuration|number_format(2) }} ms</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Hydration</b>
            <span>{{ collector.hydrationDuration|number_format(2) }} ms</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Errors</b>
            <span class="sf-toolbar-status {{ collector.errorCount > 0 ? 'sf-toolbar-status-red' }}">{{ collector.errorCount|default(0) }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Invalid entities</b>
            {% if validation is null or validation.violations is null %}
                <span>{{ validation.failure ?? null ? 'introspection failed' : 'not checked' }}</span>
            {% else %}
                <span class="sf-toolbar-status {{ validation.violations is not empty ? 'sf-toolbar-status-yellow' }}">{{ validation.violations|length }}</span>
            {% endif %}
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Entities hydrated</b>
            <span>{{ collector.hydratedEntityCount }}{% if collector.identityMapHitCount > 0 %}, {{ collector.identityMapHitCount }} from the identity map{% endif %}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Result cache</b>
            <span>{{ resultCache is null ? 'disabled' : resultCache.hits ~ '/' ~ resultCache.lookups ~ ' hits' ~ (resultCacheAdapters ? ' (' ~ resultCacheAdapters ~ ')') }}</span>
        </div>
        <div class="sf-toolbar-info-piece">
            <b>Second-level cache</b>
            <span>{{ secondLevelCache is null ? 'disabled' : secondLevelCache.hits ~ '/' ~ secondLevelCache.lookups ~ ' hits' ~ (secondLevelAdapters ? ' (' ~ secondLevelAdapters ~ ')') }}</span>
        </div>
        {% if collector.cacheWarnings is not empty %}
            <div class="sf-toolbar-info-piece">
                <b>Cache warnings</b>
                <span class="sf-toolbar-status sf-toolbar-status-yellow">{{ collector.cacheWarnings|length }}</span>
            </div>
        {% endif %}
        {% if collector.slowQueryCount|default(0) > 0 %}
            <div class="sf-toolbar-info-piece">
                <b>Slow</b>
                <span class="sf-toolbar-status sf-toolbar-status-yellow" title="over {{ collector.slowQueryThreshold }} ms">{{ collector.slowQueryCount }}</span>
            </div>
        {% endif %}
        {% if collector.lazyLoadsByRelation is not empty %}
            <div class="sf-toolbar-info-piece">
                <b>N+1</b>
                <span class="sf-toolbar-status sf-toolbar-status-yellow">{{ collector.lazyLoadsByRelation|length }}</span>
            </div>
        {% endif %}
        {% if collector.repeatedQueries is not empty %}
            <div class="sf-toolbar-info-piece">
                <b>Repeated</b>
                <span class="sf-toolbar-status sf-toolbar-status-yellow">{{ collector.repeatedQueries|length }}</span>
            </div>
        {% endif %}
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {
        link: profiler_url,
        icon: icon,
        text: text,
        status: collector.errorCount > 0 ? 'red' : (collector.repeatedQueries is not empty or collector.lazyLoadsByRelation is not empty or collector.slowQueryCount|default(0) > 0 or collector.cacheWarnings is not empty ? 'yellow')
    }) }}

{% endblock %}

{# ================= MENU ================= #}

{% block menu %}
    <span class="label {% if collector.errorCount > 0 %}label-status-error{% endif %}">
    <span class="icon">
        {{ source('@GraphqlOrm/collector/icon.svg') }}
    </span>

    <strong>GraphQL ORM</strong>
    {% if collector.queryCount > 0 %}
        <span class="count">
        <span>{{ collector.queryCount }}</span>
    </span>
    {% endif %}
</span>
{% endblock %}

{# ================= PANEL ================= #}

{% block panel %}
    <h2>GraphQL ORM</h2>
    {# A request may only read the second-level cache, or evict from the caches, without sending a query #}
    {% if collector.queryCount == 0 and collector.secondLevelCache is empty and collector.cacheEvictions is empty and collector.cacheWarnings is empty %}
        <div class="empty">
            <p>No GraphQL queries were executed.</p>
        </div>
    {% else %}
        {% set durations = collector.queries|map(query => query.duration + (query.hydration_duration ?? 0)) %}
        {% set maxDuration = max(durations|merge([0.001])) %}
        {% set offsets = collector.queryOffsets %}
        {% set span = max(collector.timelineSpan, 0.001) %}
        {% set lazyLoads = collector.lazyLoadsByRelation %}
        {% set findingCount = lazyLoads|length + collector.repeatedQueries|length %}
        <div id="graphql-orm-panel">
            <div class="metrics">
                <div class="metric">
                    <span class="value">{{ collector.queryCount }}</span>
                    <span class="label">Queries</span>
                </div>
                <div class="metric">
                    <span class="value">{{ collector.waitedDuration|number_format(1) }} <span class="unit">ms</span></span>
                    <span class="label">Time in GraphQL</span>
                    {% if collector.totalDuration - collector.waitedDuration > 0.05 %}
                        <span class="graphql-orm-muted" title="The duration of each query added up: some were sent together and waited for at the same time">{{ collector.totalDuration|number_format(1) }} ms summed, queries sent together</span>
                    {% endif %}
                </div>
                <div class="metric">
                    <span class="value">{{ collector.hydrationDuration|number_format(1) }} <span class="unit">ms</span></span>
                    <span class="label">Hydration</span>
                </div>
                {% if collector.slowQueryThreshold is not null %}
                    <div class="metric">
                        <span class="value">{{ collector.slowQueryCount }}</span>
                        <span class="label">Slow (&ge; {{ collector.slowQueryThreshold }} ms)</span>
                    </div>
                {% endif %}
                <div class="metric">
                    <span class="value">{{ collector.errorCount }}</span>
                    <span class="label">Errors</span>
                </div>
                <div class="metric">
                    <span class="value">{{ collector.hydratedEntityCount }}</span>
                    <span class="label">Entities hydrated</span>
                </div>
                {% if collector.resultCacheHitCount > 0 %}
                    <div class="metric">
                        <span class="value">{{ collector.resultCacheHitCount }}</span>
                        <span class="label">Served by the result cache</span>
                    </div>
                {% endif %}
                {% if collector.identityMapHitCount > 0 %}
                    <div class="metric">
                        <span class="value">{{ collector.identityMapHitCount }}</span>
                        <span class="label">Served by identity map</span>
                    </div>
                {% endif %}
                <div class="metric">
                    <span class="value">{{ (collector.responseSize / 1024)|number_format(1) }} <span class="unit">KB</span></span>
                    <span class="label">Received</span>
                </div>
            </div>

            {% for load in lazyLoads %}
                <div class="graphql-orm-alert">
                    <strong>N+1: <code>{{ load.relation|split('\\')|last }}</code> loaded {{ load.count }} times on first access</strong>
                    <span>{{ load.duration|number_format(1) }} ms{% if load.callers is not empty %}, read in <code>{{ load.callers|first }}</code>{% endif %}</span>
                    <a href="#graphql-orm-findings" data-graphql-orm-goto="findings">See how to avoid it</a>
                </div>
            {% endfor %}
            {% set serialization = collector.serialization %}
            {% if serialization.lazy_loads is not empty %}
                <div class="graphql-orm-alert">
                    <strong>{{ serialization.lazy_loads|length }} {{ serialization.lazy_loads|length > 1 ? 'relations' : 'relation' }} loaded while serializing</strong>
                    <span>a normalizer read a relation not loaded: an N+1 hidden in the response</span>
                    <a href="#graphql-orm-serializer" data-graphql-orm-goto="serializer">See which ones</a>
                </div>
            {% endif %}
            {% for warning in collector.cacheWarnings %}
                <div class="graphql-orm-alert">
                    <strong>{{ warning }}</strong>
                    <a href="#graphql-orm-cache" data-graphql-orm-goto="cache">See the caches</a>
                </div>
            {% endfor %}
            {% if collector.repeatedQueries is not empty %}
                <div class="graphql-orm-alert">
                    <strong>{{ collector.repeatedQueries|length }} {{ collector.repeatedQueries|length > 1 ? 'queries are' : 'query is' }} repeated with other values</strong>
                    <a href="#graphql-orm-findings" data-graphql-orm-goto="findings">See which ones</a>
                </div>
            {% endif %}

            <div class="tab-navigation graphql-orm-tabs" role="tablist">
                <button type="button" class="tab-control active" role="tab" aria-selected="true" data-graphql-orm-tab="queries">
                    Queries <span class="badge">{{ collector.queryCount }}</span>
                </button>
                <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="timeline">Timeline</button>
                <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="configuration">
                    Configuration
                    {% if collector.schemaValidation.violations ?? null %}<span class="badge status-warning">{{ collector.schemaValidation.violations|length }}</span>{% endif %}
                </button>
                {% if collector.entities is not empty %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="entities">
                        Entities <span class="badge">{{ collector.entities|length }}</span>
                    </button>
                {% endif %}
                {% if collector.lazyLoading is not empty %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="lazy-loading">
                        Lazy loading <span class="badge">{{ collector.lazyLoading|reduce((total, group) => total + group.created, 0) }}</span>
                    </button>
                {% endif %}
                {% if collector.partialEntities is not empty %}
                    {% set partialExceptions = collector.partialEntities|reduce((total, group) => total + group.exceptions, 0) %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="partial-entities">
                        Partial entities
                        <span class="badge{{ partialExceptions > 0 ? ' status-warning' : '' }}">{{ partialExceptions > 0 ? partialExceptions : collector.partialEntities|reduce((total, group) => total + group.hydrated, 0) }}</span>
                    </button>
                {% endif %}
                {% if serialization.identifiers + serialization.partial > 0 or serialization.lazy_loads is not empty %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="serializer">
                        Serializer
                        {% if serialization.lazy_loads is not empty %}<span class="badge status-warning">{{ serialization.lazy_loads|length }}</span>{% endif %}
                    </button>
                {% endif %}
                {% set resultCacheQueries = collector.queries|filter(query => (query.result_cache ?? null) is not null) %}
                {% set cachedEntityQueries = collector.queries|filter(query => (query.from_cached_entity ?? false)) %}
                {% set showCache = resultCacheQueries is not empty or collector.secondLevelCache is not empty or collector.cacheEvictions is not empty or collector.cacheOperations is not empty or collector.cacheWarnings is not empty %}
                {% if showCache %}
                    {% set cacheHits = resultCacheQueries|filter(query => query.result_cache == 'hit')|length + collector.secondLevelCache|reduce((total, entry) => total + entry.hits, 0) %}
                    {% set cacheLookups = resultCacheQueries|length + collector.secondLevelCache|reduce((total, entry) => total + entry.hits + entry.misses, 0) %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="cache">
                        Cache <span class="badge" title="Results and entities read from the caches / looked up">{{ cacheHits }}/{{ cacheLookups }}</span>
                    </button>
                {% endif %}
                {% if collector.autocompleteSearches is not empty %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="autocomplete">
                        Autocomplete <span class="badge">{{ collector.autocompleteSearches|length }}</span>
                    </button>
                {% endif %}
                {% if collector.identityMapHitCount > 0 %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="identity-map">
                        Identity map <span class="badge">{{ collector.identityMapHitCount }}</span>
                    </button>
                {% endif %}
                {% if findingCount > 0 %}
                    <button type="button" class="tab-control" role="tab" aria-selected="false" data-graphql-orm-tab="findings">
                        N+1 &amp; repeated <span class="badge status-warning">{{ findingCount }}</span>
                    </button>
                {% endif %}
            </div>

            <div data-graphql-orm-view="queries">
                <div class="graphql-orm-toolbar" role="group" aria-label="Filter the queries">
                    <button type="button" class="graphql-orm-chip" aria-pressed="true" data-graphql-orm-filter="all">All {{ collector.queryCount }}</button>
                    {% if collector.slowQueryCount|default(0) > 0 %}
                        <button type="button" class="graphql-orm-chip" aria-pressed="false" data-graphql-orm-filter="slow">Slow {{ collector.slowQueryCount }}</button>
                    {% endif %}
                    {% if collector.errorCount > 0 %}
                        <button type="button" class="graphql-orm-chip" aria-pressed="false" data-graphql-orm-filter="error">Errors {{ collector.errorCount }}</button>
                    {% endif %}
                    <input type="search" class="graphql-orm-search" placeholder="Search the queries" aria-label="Search the queries">
                </div>

                <table class="graphql-orm-queries">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Origin</th>
                            <th>Root field</th>
                            <th>Duration</th>
                            <th class="graphql-orm-number">Size</th>
                            <th class="graphql-orm-number">Entities</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for query in collector.queries|slice(0, collector.detailedQueryLimit) %}
                            {% set status = query.errors ? 'error' : ((query.slow ?? false) ? 'slow' : 'ok') %}
                            <tr id="graphql-orm-query-{{ loop.index }}"
                                class="graphql-orm-row {{ status == 'error' ? 'status-error' : (status == 'slow' ? 'status-warning') }}"
                                tabindex="0" aria-expanded="false"
                                data-graphql-orm-row="{{ loop.index }}"
                                data-graphql-orm-status="{{ status }}"
                                data-graphql-orm-text="{{ query.graphql|lower }}">
                                <td class="graphql-orm-number">{{ loop.index }}</td>
                                <td>{{ _self.renderOrigin(query) }}</td>
                                <td>
                                    {% if (collector.configuration.managers ?? [])|length > 1 and (query.manager ?? null) %}<span class="badge" title="The manager of the API">{{ query.manager }}</span>{% endif %}
                                    <code>{{ query.root_field ?? '-' }}</code>
                                    {% if query.entity_class ?? null %}
                                        <span class="graphql-orm-muted" title="{{ query.entity_class }}">{{ query.entity_class|split('\\')|last }}</span>
                                    {% endif %}
                                    {% if query.hydrated_as ?? null %}
                                        <span class="badge" title="Hydrated as the DTO {{ query.hydrated_as }} with hydrateAs(): no entity">DTO {{ query.hydrated_as|split('\\')|last }}</span>
                                    {% endif %}
                                    {% if query.caller %}
                                        <div class="graphql-orm-muted">{{ query.caller.file|split('/')|last }}:{{ query.caller.line }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set hydration = query.hydration_duration ?? 0 %}
                                    <div class="graphql-orm-bar" title="Network{{ hydration > 0 ? ' + hydration' }}">
                                        <span class="graphql-orm-track">
                                            <span class="graphql-orm-fill graphql-orm-fill-{{ status }}" style="width: {{ max(2, query.duration / maxDuration * 100)|round(1) }}%"></span>
                                            {% if hydration > 0 %}<span class="graphql-orm-fill graphql-orm-fill-hydration" style="width: {{ (hydration / maxDuration * 100)|round(1) }}%"></span>{% endif %}
                                        </span>
                                        <span class="graphql-orm-number">{{ query.duration|number_format(1) }} ms{% if hydration > 0 %} + {{ hydration|number_format(1) }} ms{% endif %}</span>
                                    </div>
                                </td>
                                <td class="graphql-orm-number">{{ (query.response_size / 1024)|number_format(1) }} KB</td>
                                <td class="graphql-orm-number">
                                    {% if query.hydrated_as ?? null %}
                                        <span class="graphql-orm-muted" title="Hydrated as {{ query.hydrated_as }}: no entity">{{ query.hydrated_count }} DTO{{ query.hydrated_count == 1 ? '' : 's' }}</span>
                                    {% else %}
                                        {{ query.hydrated_entities }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if status == 'error' %}
                                        <span class="badge badge-danger">Error</span>
                                    {% elseif status == 'slow' %}
                                        <span class="badge badge-warning graphql-orm-slow-badge" title="over {{ collector.slowQueryThreshold }} ms">Slow</span>
                                    {% else %}
                                        <span class="badge badge-success">OK</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr class="graphql-orm-detail" data-graphql-orm-detail="{{ loop.index }}" hidden>
                                <td colspan="7">
                                    {{ _self.renderDetail(query, loop.index, collector.configuration.result_cache.pool ?? null) }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if collector.queries|length > collector.detailedQueryLimit %}
                    <p class="graphql-orm-warning">And {{ collector.queries|length - collector.detailedQueryLimit }} more queries, counted in the metrics: the profile keeps the detail of the first {{ collector.detailedQueryLimit }}.</p>
                {% endif %}
                <p class="graphql-orm-muted">Click a query to see its GraphQL, its variables, its AST and its hydration.</p>
            </div>

            <div data-graphql-orm-view="timeline" hidden>
                {% set ticks = collector.timelineTicks %}
                {% set step = ticks|length > 1 ? (ticks[1] - ticks[0]) / span * 100 : 100 %}
                {% set networkTime = collector.waitedDuration %}
                {# The request runs before its first query: the kernel, the routing, the controller... #}
                {% set firstOffset = min(offsets|merge([span])) %}
                <p class="graphql-orm-timeline-summary">
                    {{ collector.queries|length }} {{ collector.queries|length == 1 ? 'query' : 'queries' }} over {{ span|number_format(0) }} ms,
                    {{ networkTime|number_format(1) }} ms in GraphQL{% if firstOffset > 0 %}, the first one sent {{ firstOffset|number_format(1) }} ms after the start of the request{% endif %}.
                    Times are counted from the start of the request; overlapping bars are queries sent together, e.g. by
                    <code>GraphqlQuery::concurrently()</code>.
                </p>
                <div class="graphql-orm-timeline" style="--graphql-orm-step: {{ step|round(3) }}%">
                    <div class="graphql-orm-timeline-row graphql-orm-timeline-head" aria-hidden="true">
                        <span></span>
                        <div class="graphql-orm-timeline-axis">
                            {% for tick in ticks %}
                                <span style="left: {{ (tick / span * 100)|round(1) }}%">{{ tick == tick|round ? tick|number_format(0) : tick|number_format(1) }} ms</span>
                            {% endfor %}
                        </div>
                        <span></span>
                    </div>
                    {% for query in collector.queries|slice(0, collector.detailedQueryLimit) %}
                        {% set status = query.errors ? 'error' : ((query.slow ?? false) ? 'slow' : 'ok') %}
                        {% set kind = _self.originKind(query.origin ?? null)|trim %}
                        {% set hydration = query.hydration_duration ?? 0 %}
                        {% set offset = offsets[loop.index0] %}
                        <a href="#graphql-orm-query-{{ loop.index }}" data-graphql-orm-open="{{ loop.index }}"
                           class="graphql-orm-timeline-row graphql-orm-timeline-query"
                           title="Started at {{ offset|number_format(1) }} ms: {{ query.duration|number_format(1) }} ms on the network{{ hydration > 0 ? ' + ' ~ hydration|number_format(1) ~ ' ms hydrating' }}{{ query.caller ?? null ? ', from ' ~ (query.caller.file|split('/')|last) ~ ':' ~ query.caller.line }}">
                            <span class="graphql-orm-timeline-label">
                                <span class="graphql-orm-muted">#{{ loop.index }}</span>
                                {% if query.origin ?? null %}
                                    <span class="graphql-orm-origin graphql-orm-origin-{{ kind }}">{{ query.origin }}</span>
                                {% else %}
                                    <code>{{ query.root_field ?? '-' }}</code>
                                {% endif %}
                                {% if query.entity_class ?? null %}<span class="graphql-orm-muted">{{ query.entity_class|split('\\')|last }}</span>{% endif %}
                            </span>
                            <span class="graphql-orm-timeline-track">
                                {% if firstOffset > 0 %}<span class="graphql-orm-timeline-before" style="width: {{ (firstOffset / span * 100)|round(1) }}%"></span>{% endif %}
                                <span class="graphql-orm-timeline-bar graphql-orm-fill-{{ status }} graphql-orm-kind-{{ kind }}"
                                      style="left: {{ (offset / span * 100)|round(1) }}%; width: {{ max(0.3, query.duration / span * 100)|round(1) }}%"></span>
                                {% if hydration > 0 %}
                                    <span class="graphql-orm-timeline-bar graphql-orm-fill-hydration"
                                          style="left: {{ ((offset + query.duration) / span * 100)|round(1) }}%; width: {{ max(0.2, hydration / span * 100)|round(1) }}%"></span>
                                {% endif %}
                            </span>
                            <span class="graphql-orm-timeline-duration graphql-orm-timeline-{{ status }}">{{ (query.duration + hydration)|number_format(1) }} ms</span>
                        </a>
                    {% endfor %}
                </div>
                {% if collector.queries|length > collector.detailedQueryLimit %}
                    <p class="graphql-orm-warning">And {{ collector.queries|length - collector.detailedQueryLimit }} more queries, not drawn: the profile keeps the detail of the first {{ collector.detailedQueryLimit }}.</p>
                {% endif %}
                <p class="graphql-orm-timeline-legend">
                    <span><i class="graphql-orm-swatch graphql-orm-kind-query"></i>Network</span>
                    <span><i class="graphql-orm-swatch graphql-orm-fill-hydration"></i>Hydration</span>
                    <span><i class="graphql-orm-swatch graphql-orm-fill-slow"></i>Slow</span>
                    <span><i class="graphql-orm-swatch graphql-orm-fill-error"></i>Error</span>
                    <span><i class="graphql-orm-swatch graphql-orm-kind-lazy"></i>Lazy load</span>
                    <span><i class="graphql-orm-swatch graphql-orm-kind-count"></i>Aggregate</span>
                    <span><i class="graphql-orm-swatch graphql-orm-kind-introspection"></i>Introspection</span>
                    {% if firstOffset > 0 %}<span><i class="graphql-orm-swatch graphql-orm-timeline-before"></i>Before the first query</span>{% endif %}
                </p>
            </div>

            <div data-graphql-orm-view="configuration" hidden>
                {% if collector.configuration is not empty %}
                    <table>
                        <tbody>
                            {% for name, value in collector.configuration %}
                                <tr>
                                    <th>{{ name }}</th>
                                    <td>{{ _self.renderValue(value) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                {% if collector.introspectionCaches is not empty %}
                    {% set cacheLabels = {argument_types: 'Argument types (variables)', countable_fields: 'Countable fields (count())', schema_validation: 'Schema validation'} %}
                    <h3>Introspection caches</h3>
                    <table>
                        <thead>
                            <tr><th>Cache</th><th class="graphql-orm-number">Lookups</th><th>Outcome</th><th class="graphql-orm-number">Time</th></tr>
                        </thead>
                        <tbody>
                            {% for cache in collector.introspectionCaches %}
                                <tr>
                                    <td>{{ cacheLabels[cache.name] ?? cache.name }}</td>
                                    <td class="graphql-orm-number">{{ cache.lookups }}</td>
                                    <td>{% if cache.introspected > 0 %}<span class="graphql-orm-warning">introspected</span>{% else %}served by the cache{% endif %}</td>
                                    <td class="graphql-orm-number">{{ cache.duration|number_format(1) }} ms</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                <h3>Schema validation</h3>
                {% set validation = collector.schemaValidation %}
                {% if validation is null %}
                    <p class="graphql-orm-muted">Not reported for this request.</p>
                {% elseif validation.failure %}
                    <div class="graphql-orm-error">{{ validation.failure }}</div>
                {% elseif validation.violations is null %}
                    <p class="graphql-orm-muted">Mode <code>{{ validation.mode }}</code>: the mapping is not checked against the schema.</p>
                {% elseif validation.violations is empty %}
                    <p>Mode <code>{{ validation.mode }}</code>: <span class="badge badge-success">the mapping matches the schema</span></p>
                {% else %}
                    <p>Mode <code>{{ validation.mode }}</code>: <span class="badge badge-warning">{{ validation.violations|length }} {{ validation.violations|length > 1 ? 'violations' : 'violation' }}</span></p>
                    <ul>
                        {% for violation in validation.violations %}
                            <li>{{ violation }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {% if collector.entities is not empty %}
                <div data-graphql-orm-view="entities" hidden>
                    <p class="graphql-orm-muted">
                        The entities of the mapping directory, and those read by the queries of this request (first), as the
                        bundle maps them.
                    </p>
                    {% for entity in collector.entities %}
                        <div class="graphql-orm-entity">
                            <h3>
                                <code title="{{ entity.class }}">{{ entity.class|split('\\')|last }}</code>
                                {% if entity.queries > 0 %}<span class="badge">{{ entity.queries }} {{ entity.queries > 1 ? 'queries' : 'query' }}</span>{% endif %}
                            </h3>
                            {% if entity.error %}
                                <div class="graphql-orm-error">{{ entity.error }}</div>
                            {% else %}
                                <p class="graphql-orm-muted">
                                    Root field <code>{{ entity.name }}</code>,
                                    {% if entity.identifier %}identified by <code>{{ entity.identifier }}</code>{% else %}no identifier{% endif %}{% if entity.repository %},
                                    repository <code title="{{ entity.repository }}">{{ entity.repository|split('\\')|last }}</code>{% endif %}
                                </p>
                                <table>
                                    <thead>
                                        <tr><th>Property</th><th>GraphQL field</th><th>Relation</th><th>Fetch</th><th>Converter</th></tr>
                                    </thead>
                                    <tbody>
                                        {% for field in entity.fields %}
                                            <tr>
                                                <td>{{ field.property }}{% if field.property == entity.identifier %} <span class="badge">identifier</span>{% endif %}</td>
                                                <td><code>{{ field.field }}</code></td>
                                                <td>
                                                    {% if field.relation %}<span title="{{ field.relation }}">{{ field.relation|split('\\')|last }}{{ field.collection ? '[]' }}</span>
                                                    {% elseif field.embedded ?? null %}<span title="{{ field.embedded.class }}: {{ field.embedded.fields|join(', ') }}">{{ field.embedded.class|split('\\')|last }}</span> <span class="graphql-orm-muted">embedded, {{ field.embedded.fields|join(', ') }}</span>
                                                    {% else %}<span class="graphql-orm-muted">-</span>{% endif %}
                                                </td>
                                                <td>{{ field.fetch ?? '-' }}</td>
                                                <td>
                                                    {% if field.converter ?? null %}
                                                        <span title="{{ field.converter }}">{{ field.converter|split('\\')|last }}</span>
                                                        <span class="graphql-orm-muted">{{ field.converter_source == 'field' ? 'by #[GraphqlOrm\\Field]' : 'by type' }}</span>
                                                    {% else %}
                                                        <span class="graphql-orm-muted">-</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if collector.lazyLoading is not empty %}
                {% set created = collector.lazyLoading|reduce((total, group) => total + group.created, 0) %}
                {% set unread = collector.lazyLoading|reduce((total, group) => total + group.unread, 0) %}
                <div data-graphql-orm-view="lazy-loading" hidden>
                    <p class="graphql-orm-muted">
                        {{ created }} {{ created > 1 ? 'entities were' : 'entity was' }} left to be loaded on first access
                        (<code>Fetch::Lazy</code>, <code>lazy_loading</code>, references from Doctrine entities):
                        {{ created - unread }} loaded, {{ unread }} never read, which cost no query.
                    </p>
                    <table>
                        <thead>
                            <tr><th>Relation</th><th>Entity</th><th class="graphql-orm-number">Created</th><th class="graphql-orm-number">Loaded</th><th class="graphql-orm-number">Never read</th><th>Loaded by</th></tr>
                        </thead>
                        <tbody>
                            {% for group in collector.lazyLoading %}
                                <tr>
                                    <td><code title="{{ group.relation }}">{{ group.relation|split('\\')|last }}</code></td>
                                    <td title="{{ group.class }}">{{ group.class|split('\\')|last }}</td>
                                    <td class="graphql-orm-number">{{ group.created }}</td>
                                    <td class="graphql-orm-number">{{ group.loaded }}</td>
                                    <td class="graphql-orm-number">{{ group.unread }}</td>
                                    <td>{% for number in group.queries %}<a href="#graphql-orm-query-{{ number }}" data-graphql-orm-open="{{ number }}">#{{ number }}</a>{{ loop.last ? '' : ', ' }}{% else %}<span class="graphql-orm-muted">-</span>{% endfor %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if collector.partialEntities is not empty %}
                <div data-graphql-orm-view="partial-entities" hidden>
                    <p class="graphql-orm-muted">
                        Entities hydrated from a selection of their fields (<code>select()</code>): reading a field not selected
                        and left without a value throws a <code>PartialEntityException</code>: select it.
                    </p>
                    <table>
                        <thead>
                            <tr><th>Entity</th><th>Not selected</th><th class="graphql-orm-number">Hydrated</th><th>By</th><th class="graphql-orm-number">Exceptions</th></tr>
                        </thead>
                        <tbody>
                            {% for group in collector.partialEntities %}
                                <tr>
                                    <td title="{{ group.class }}">{{ group.class|split('\\')|last }}</td>
                                    <td>{{ group.unselected|join(', ') }}</td>
                                    <td class="graphql-orm-number">{{ group.hydrated }}</td>
                                    <td>{% for number in group.queries %}<a href="#graphql-orm-query-{{ number }}" data-graphql-orm-open="{{ number }}">#{{ number }}</a>{{ loop.last ? '' : ', ' }}{% endfor %}</td>
                                    <td class="graphql-orm-number">{% if group.exceptions > 0 %}<strong class="graphql-orm-warning">{{ group.exceptions }}</strong> ({{ group.missing|join(', ') }}){% else %}0{% endif %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if serialization.identifiers + serialization.partial > 0 or serialization.lazy_loads is not empty %}
                <div data-graphql-orm-view="serializer" id="graphql-orm-serializer" hidden>
                    <div class="metrics">
                        <div class="metric">
                            <span class="value">{{ serialization.identifiers }}</span>
                            <span class="label">Relations written as identifiers</span>
                        </div>
                        <div class="metric">
                            <span class="value">{{ serialization.partial }}</span>
                            <span class="label">Partial entities written</span>
                        </div>
                        <div class="metric">
                            <span class="value">{{ serialization.lazy_loads|length }}</span>
                            <span class="label">Queries sent while serializing</span>
                        </div>
                    </div>
                    {% if serialization.lazy_loads is not empty %}
                        <p class="graphql-orm-muted">
                            These lazy loads were sent by the serializer reading a relation not loaded. Select the relation in
                            the query, or register <code>GraphqlEntityNormalizer</code> (it writes such a relation as its
                            identifier, without a query).
                        </p>
                        <table>
                            <thead>
                                <tr><th>Query</th><th>Relation</th><th class="graphql-orm-number">Time</th></tr>
                            </thead>
                            <tbody>
                                {% for number in serialization.lazy_loads %}
                                    {% set query = collector.queries[number - 1] %}
                                    <tr>
                                        <td><a href="#graphql-orm-query-{{ number }}" data-graphql-orm-open="{{ number }}">#{{ number }}</a></td>
                                        <td>{% if query.lazy_relation ?? null %}<code title="{{ query.lazy_relation }}">{{ query.lazy_relation|split('\\')|last }}</code>{% else %}<span class="graphql-orm-muted">-</span>{% endif %}</td>
                                        <td class="graphql-orm-number">{{ (query.duration ?? 0)|number_format(1) }} ms</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="graphql-orm-muted">The serializer sent no query: every relation it wrote was loaded or written as its identifier.</p>
                    {% endif %}
                </div>
            {% endif %}

            {% if showCache %}
                <div data-graphql-orm-view="cache" id="graphql-orm-cache" hidden>
                    {% if collector.cachePools is not empty %}
                        <h3>Pools</h3>
                        <table>
                            <thead>
                                <tr><th>Cache</th><th>Pool</th><th>Adapter</th><th class="graphql-orm-number">Lifetime</th></tr>
                            </thead>
                            <tbody>
                                {% for pool in collector.cachePools %}
                                    <tr>
                                        <td>{{ pool.name }}</td>
                                        <td><code>{{ pool.id }}</code></td>
                                        <td>{{ pool.adapter }}</td>
                                        <td class="graphql-orm-number">{{ pool.lifetime is not null ? pool.lifetime ~ ' s' : 'per query' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% if collector.cacheOperations is not empty %}
                        <h3>Operations</h3>
                        <table>
                            <thead>
                                <tr><th>Cache</th><th class="graphql-orm-number">Read</th><th class="graphql-orm-number">Written</th><th class="graphql-orm-number">Deleted</th><th class="graphql-orm-number">Time</th><th class="graphql-orm-number">Size written</th></tr>
                            </thead>
                            <tbody>
                                {% for operation in collector.cacheOperations %}
                                    <tr>
                                        <td>{{ operation.name }}</td>
                                        <td class="graphql-orm-number">{{ operation.reads }}</td>
                                        <td class="graphql-orm-number">{{ operation.writes }}</td>
                                        <td class="graphql-orm-number">{{ operation.deletes }}</td>
                                        <td class="graphql-orm-number">{{ operation.duration|number_format(2) }} ms</td>
                                        <td class="graphql-orm-number">{{ (operation.bytes_written / 1024)|number_format(1) }} KB</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <p class="graphql-orm-muted">Values counted one by one; the size is that of PHP serialize(), before the compression of the adapter if any.</p>
                    {% endif %}

                    {% if cachedEntityQueries is not empty %}
                        <p class="graphql-orm-warning">
                            {{ cachedEntityQueries|length }} {{ cachedEntityQueries|length > 1 ? 'queries' : 'query' }} sent by the relations of entities read from the cache:
                            {% for number, query in collector.queries %}{% if query.from_cached_entity ?? false %}<a href="#graphql-orm-query-{{ number + 1 }}" data-graphql-orm-open="{{ number + 1 }}">#{{ number + 1 }}</a> {% endif %}{% endfor %}
                        </p>
                        <p class="graphql-orm-muted">An entity of the second-level cache keeps its relations by their identifier: they are loaded on first access.</p>
                    {% endif %}

                    {% if profile is defined and profile.hasCollector('cache') %}
                        <p><a href="?panel=cache">The calls to the pools in the Cache panel of Symfony</a></p>
                    {% endif %}

                    {% if resultCacheQueries is not empty %}
                        <h3>Result cache</h3>
                        <table>
                            <thead>
                                <tr><th>Query</th><th>Outcome</th><th>Key</th><th class="graphql-orm-number">Lifetime</th></tr>
                            </thead>
                            <tbody>
                                {% for number, query in collector.queries %}
                                    {% if (query.result_cache ?? null) is not null %}
                                        <tr>
                                            <td><a href="#graphql-orm-query-{{ number + 1 }}" data-graphql-orm-open="{{ number + 1 }}">#{{ number + 1 }}</a> {{ query.root_field ?? '' }}</td>
                                            <td>{{ query.result_cache }}</td>
                                            <td>{% if query.result_cache_key %}<code>{{ query.result_cache_key }}</code>{% else %}<span class="graphql-orm-muted">derived from the query</span>{% endif %}</td>
                                            <td class="graphql-orm-number">{{ query.result_cache_lifetime is not null ? query.result_cache_lifetime ~ ' s' : 'pool default' }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% if collector.secondLevelCache is not empty %}
                    <h3>Second-level cache</h3>
                    <p class="graphql-orm-muted">
                        The entities marked <code>#[GraphqlOrm\Cache]</code>: read from the second-level cache by <code>find()</code>, the
                        references and the lazy loads (hits) or not found there (misses), and kept once hydrated in full.
                    </p>
                    <table>
                        <thead>
                            <tr><th>Entity</th><th>Region</th><th class="graphql-orm-number">Hits</th><th class="graphql-orm-number">Misses</th><th class="graphql-orm-number">Kept</th></tr>
                        </thead>
                        <tbody>
                            {% for entry in collector.secondLevelCache %}
                                <tr>
                                    <td title="{{ entry.class }}">{{ entry.class|split('\\')|last }}</td>
                                    <td>{% if entry.region %}<code>{{ entry.region }}</code>{% else %}<span class="graphql-orm-muted">default</span>{% endif %}</td>
                                    <td class="graphql-orm-number">{{ entry.hits }}</td>
                                    <td class="graphql-orm-number">{{ entry.misses }}</td>
                                    <td class="graphql-orm-number">{{ entry.puts }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <table>
                        <thead>
                            <tr><th>Entity</th><th>Identifier</th><th>Outcome</th><th>By</th><th class="graphql-orm-number">Times</th></tr>
                        </thead>
                        <tbody>
                            {% for entry in collector.secondLevelCacheEntries %}
                                <tr>
                                    <td title="{{ entry.class }}">{{ entry.class|split('\\')|last }}</td>
                                    <td><code>{{ entry.identifier }}</code></td>
                                    <td>{{ entry.outcome }}</td>
                                    <td title="{{ entry.trigger }}">{{ _self.shortTrigger(entry.trigger) }}</td>
                                    <td class="graphql-orm-number">{{ entry.count }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% endif %}

                    {% if collector.cacheEvictions is not empty %}
                        <h3>Evictions</h3>
                        <table>
                            <thead>
                                <tr><th>Call</th><th>Evicted</th><th>Called from</th></tr>
                            </thead>
                            <tbody>
                                {% for eviction in collector.cacheEvictions %}
                                    <tr>
                                        <td><code>{{ eviction.call }}</code></td>
                                        <td title="{{ eviction.target }}">{{ eviction.target|split('\\')|last }}</td>
                                        <td>{% if eviction.caller %}<code title="{{ eviction.caller }}">{{ eviction.caller|split('/')|last }}</code>{% else %}-{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            {% endif %}

            {% if collector.autocompleteSearches is not empty %}
                <div data-graphql-orm-view="autocomplete" hidden>
                    <p class="graphql-orm-muted">
                        The searches of autocomplete fields answered by the bundle: the entities whose fields contain the
                        text typed, up to the number of results of the field (<code>max_results</code>).
                    </p>
                    <table>
                        <thead>
                            <tr><th>Entity</th><th>Fields searched</th><th>Text</th><th class="graphql-orm-number">Results</th><th class="graphql-orm-number">Limit</th></tr>
                        </thead>
                        <tbody>
                            {% for search in collector.autocompleteSearches %}
                                <tr>
                                    <td title="{{ search.class }}">{{ search.class|split('\\')|last }}</td>
                                    <td>{{ search.fields|join(', ') }}</td>
                                    <td>{% if search.query is not same as('') %}<code>{{ search.query }}</code>{% else %}<span class="graphql-orm-muted">(empty)</span>{% endif %}</td>
                                    <td class="graphql-orm-number">{{ search.results }}</td>
                                    <td class="graphql-orm-number">{{ search.limit }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if collector.identityMapHitCount > 0 %}
                <div data-graphql-orm-view="identity-map" hidden>
                    <p class="graphql-orm-muted">
                        Entities that <code>find()</code> served from the shared identity map, known in full from an
                        earlier query of the request: each one is a query not sent.
                    </p>
                    <table>
                        <thead>
                            <tr><th>Entity</th><th>Identifier</th><th class="graphql-orm-number">Served</th><th>Called from</th></tr>
                        </thead>
                        <tbody>
                            {% for hit in collector.identityMapHits %}
                                <tr>
                                    <td title="{{ hit.class }}">{{ hit.class|split('\\')|last }}</td>
                                    <td><code>{{ hit.identifier }}</code></td>
                                    <td class="graphql-orm-number">{{ hit.count }}</td>
                                    <td>{% for caller in hit.callers %}<code title="{{ caller }}">{{ caller|split('/')|last }}</code>{{ loop.last ? '' : ', ' }}{% else %}-{% endfor %}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if findingCount > 0 %}
                <div data-graphql-orm-view="findings" id="graphql-orm-findings" hidden>
                {% for load in lazyLoads %}
                    <div class="graphql-orm-finding">
                        <h3>N+1: <code title="{{ load.relation }}">{{ load.relation|split('\\')|last }}</code> loaded {{ load.count }} times on first access</h3>
                        <p>
                            Each access to this relation sent a query of its own:
                            {% for number in load.queries %}<a href="#graphql-orm-query-{{ number }}" data-graphql-orm-open="{{ number }}">#{{ number }}</a>{{ loop.last ? '' : ', ' }}{% endfor %},
                            {{ load.duration|number_format(1) }} ms in all{% if load.callers is not empty %}, read in
                            {% for caller in load.callers %}<code>{{ caller }}</code>{{ loop.last ? '' : ', ' }}{% endfor %}{% endif %}.
                        </p>
                        <p>
                            Select the relation with the entities holding it: raise <code>max_depth</code>, or select its
                            fields with the query builder. A dialect implementing <code>BatchLoadingDialect</code> loads the
                            relations met in a same response with one query.
                        </p>
                    </div>
                {% endfor %}
                {% if collector.repeatedQueries is not empty %}
                    <h3>Repeated queries</h3>
                    <p>
                        These queries differ only by their values, which is the sign of a loop sending one query per entity
                        (an N+1 problem), e.g. a <code>find()</code> in a <code>foreach</code>. Load the entities with
                        one <code>findBy()</code> on a list of identifiers, or select the relation with the entities
                        holding it.
                    </p>
                    <table>
                        <thead>
                            <tr><th>Sent</th><th>Queries</th><th>Query, values masked</th></tr>
                        </thead>
                        <tbody>
                            {% for repeated in collector.repeatedQueries %}
                                <tr>
                                    <td>{{ repeated.count }} times</td>
                                    <td>{% for number in repeated.queries %}<a href="#graphql-orm-query-{{ number }}" data-graphql-orm-open="{{ number }}">#{{ number }}</a>{{ loop.last ? '' : ', ' }}{% endfor %}</td>
                                    <td>
                                        <pre class="graphql-orm-code">{{ repeated.shape|graphql_orm_highlight }}</pre>
                                        {% if repeated.find_entity ?? null %}
                                            <p class="graphql-orm-suggestion">
                                                Each one is a <code>find()</code> of a <code title="{{ repeated.find_entity }}">{{ repeated.find_entity|split('\\')|last }}</code>:
                                                load them at once with
                                                <code>$repository->findBy(['{{ repeated.find_identifier }}' => [/* the {{ repeated.count }} identifiers */]])</code>
                                            </p>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
                </div>
            {% endif %}
        </div>
    {% endif %}

    <style>
        #graphql-orm-panel { display: flex; flex-direction: column; gap: 12px; }
        #graphql-orm-panel .metrics { margin: 0; }
        .graphql-orm-muted { color: var(--color-muted, #737373); font-size: 12px; }
        .graphql-orm-number { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .graphql-orm-alert { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; padding: 10px 14px; border-radius: 6px; border-left: 4px solid var(--color-warning, #785b02); background: var(--badge-warning-background, #fde496); color: var(--badge-warning-color, #785b02); }
        .graphql-orm-alert a { color: inherit; text-decoration: underline; }
        .graphql-orm-tabs { margin: 0; }
        .graphql-orm-finding { border: 1px solid var(--table-border-color, #d4d4d4); border-left: 4px solid var(--color-warning, #785b02); border-radius: 0 6px 6px 0; padding: 4px 16px; margin-bottom: 12px; }
        .graphql-orm-warning { color: var(--color-warning, #785b02); }
        .graphql-orm-finding h3 { margin: 10px 0 0; }
        .graphql-orm-entity { margin-bottom: 18px; }
        .graphql-orm-entity h3 { margin: 0 0 4px; display: flex; gap: 8px; align-items: center; }
        .graphql-orm-suggestion { margin: 6px 0 0; padding-left: 10px; border-left: 3px solid var(--color-success, #4f805d); }
        .graphql-orm-tabs .tab-control { border: 0; background: transparent; font: inherit; cursor: pointer; }
        .graphql-orm-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px; }
        .graphql-orm-chip { border: 1px solid var(--table-border-color, #d4d4d4); background: var(--page-background, #fff); color: var(--color-text, #262626); border-radius: 14px; padding: 2px 12px; font: inherit; font-size: 13px; cursor: pointer; }
        .graphql-orm-chip[aria-pressed="true"] { background: var(--color-link, #1d4ed8); border-color: var(--color-link, #1d4ed8); color: var(--page-background, #fff); }
        .graphql-orm-search { margin-left: auto; min-width: 0; flex: 0 1 260px; border: 1px solid var(--form-input-border-color, #d4d4d4); background: var(--page-background, #fff); color: var(--color-text, #262626); border-radius: 6px; padding: 4px 10px; font: inherit; font-size: 13px; }
        .graphql-orm-queries .graphql-orm-row { cursor: pointer; }
        .graphql-orm-queries .graphql-orm-row:hover td, .graphql-orm-queries .graphql-orm-row[aria-expanded="true"] td { background: var(--table-header, #f5f5f5); }
        .graphql-orm-queries .graphql-orm-row:focus-visible { outline: 2px solid var(--color-link, #1d4ed8); outline-offset: -2px; }
        .graphql-orm-bar { display: flex; align-items: center; gap: 8px; min-width: 160px; }
        .graphql-orm-track { display: flex; flex: 1; height: 6px; border-radius: 3px; background: var(--table-header, #f5f5f5); box-shadow: inset 0 0 0 1px var(--table-border-color, #d4d4d4); overflow: hidden; }
        .graphql-orm-fill { display: block; height: 100%; border-radius: 3px; background: var(--color-link, #1d4ed8); }
        .graphql-orm-fill-slow { background: var(--color-warning, #785b02); }
        .graphql-orm-fill-error { background: var(--color-error, #b41939); }
        .graphql-orm-fill.graphql-orm-fill-hydration { border-radius: 0 3px 3px 0; background: var(--color-muted, #737373); }
        .graphql-orm-origin { display: inline-block; font-size: 12px; font-weight: bold; border-radius: 4px; padding: 1px 6px; white-space: nowrap; background: var(--badge-light-background, #f5f5f5); color: var(--color-link, #1d4ed8); }
        .graphql-orm-origin-lazy { color: var(--highlight-variable, #e36209); }
        .graphql-orm-origin-count { color: var(--color-success, #4f805d); }
        .graphql-orm-origin-introspection { color: var(--color-muted, #737373); }
        .graphql-orm-timeline-summary { margin: 0 0 8px; }
        .graphql-orm-timeline { display: flex; flex-direction: column; overflow-x: auto; border: 1px solid var(--table-border-color, #d4d4d4); border-radius: 6px; background: var(--page-background, #fff); }
        .graphql-orm-timeline-row { display: grid; grid-template-columns: minmax(180px, 260px) minmax(400px, 1fr) 90px; gap: 12px; align-items: center; padding: 3px 12px; }
        .graphql-orm-timeline-head { padding-top: 8px; padding-bottom: 4px; border-bottom: 1px solid var(--table-border-color, #d4d4d4); }
        .graphql-orm-timeline-query { color: inherit; text-decoration: none; }
        .graphql-orm-timeline-query + .graphql-orm-timeline-query { border-top: 1px solid var(--table-header, #f5f5f5); }
        .graphql-orm-timeline-query:hover, .graphql-orm-timeline-query:focus-visible { background: var(--table-header, #f5f5f5); outline: none; }
        .graphql-orm-timeline-label { display: flex; gap: 6px; align-items: center; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .graphql-orm-timeline-axis { position: relative; height: 16px; font-size: 11px; color: var(--color-muted, #737373); font-variant-numeric: tabular-nums; }
        .graphql-orm-timeline-axis span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
        .graphql-orm-timeline-axis span:first-child { transform: none; }
        .graphql-orm-timeline-track { position: relative; height: 20px; background-image: repeating-linear-gradient(to right, var(--table-border-color, #e5e5e5) 0 1px, transparent 1px var(--graphql-orm-step, 25%)); }
        .graphql-orm-timeline-bar { position: absolute; top: 4px; height: 12px; min-width: 3px; border-radius: 3px; background: var(--color-link, #1d4ed8); }
        .graphql-orm-timeline-bar.graphql-orm-kind-lazy, .graphql-orm-swatch.graphql-orm-kind-lazy { background: var(--highlight-variable, #e36209); }
        .graphql-orm-timeline-bar.graphql-orm-kind-count, .graphql-orm-swatch.graphql-orm-kind-count { background: var(--color-success, #4f805d); }
        .graphql-orm-timeline-bar.graphql-orm-kind-introspection, .graphql-orm-swatch.graphql-orm-kind-introspection { background: var(--color-muted, #737373); }
        .graphql-orm-timeline-bar.graphql-orm-fill-slow, .graphql-orm-swatch.graphql-orm-fill-slow { background: var(--color-warning, #785b02); }
        .graphql-orm-timeline-bar.graphql-orm-fill-error, .graphql-orm-swatch.graphql-orm-fill-error { background: var(--color-error, #b41939); }
        .graphql-orm-timeline-bar.graphql-orm-fill-hydration, .graphql-orm-swatch.graphql-orm-fill-hydration { background: var(--color-muted, #737373); opacity: .55; min-width: 2px; border-radius: 0 3px 3px 0; }
        .graphql-orm-timeline-before { position: absolute; top: 0; bottom: 0; left: 0; background: repeating-linear-gradient(135deg, var(--table-border-color, #e5e5e5) 0 1px, transparent 1px 6px); }
        .graphql-orm-swatch.graphql-orm-timeline-before { position: static; border: 1px solid var(--table-border-color, #d4d4d4); }
        .graphql-orm-timeline-duration { text-align: right; font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .graphql-orm-timeline-duration.graphql-orm-timeline-slow { color: var(--color-warning, #785b02); font-weight: bold; }
        .graphql-orm-timeline-duration.graphql-orm-timeline-error { color: var(--color-error, #b41939); font-weight: bold; }
        .graphql-orm-timeline-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 8px 0 0; font-size: 12px; color: var(--color-muted, #737373); }
        .graphql-orm-swatch { display: inline-block; width: 12px; height: 8px; margin-right: 5px; border-radius: 2px; vertical-align: middle; background: var(--color-link, #1d4ed8); }
        .graphql-orm-detail > td { padding: 0; }
        .graphql-orm-detail-box { display: flex; flex-direction: column; gap: 10px; padding: 12px 16px; border-left: 3px solid var(--color-link, #1d4ed8); }
        .graphql-orm-subtabs { display: flex; flex-wrap: wrap; gap: 4px; }
        .graphql-orm-subtab { border: 1px solid var(--table-border-color, #d4d4d4); background: var(--page-background, #fff); color: var(--color-muted, #737373); border-radius: 4px; padding: 3px 10px; font: inherit; font-size: 12px; cursor: pointer; }
        .graphql-orm-subtab[aria-selected="true"] { background: var(--color-text, #262626); border-color: var(--color-text, #262626); color: var(--page-background, #fff); }
        .graphql-orm-hl-keyword { color: var(--highlight-keyword, #d73a49); font-weight: bold; }
        .graphql-orm-hl-field { color: var(--highlight-default, #222222); }
        .graphql-orm-hl-argument { color: var(--highlight-constant, #1750eb); }
        .graphql-orm-hl-type { color: var(--highlight-variable, #e36209); }
        .graphql-orm-hl-variable { color: var(--highlight-variable, #e36209); font-style: italic; }
        .graphql-orm-hl-string { color: var(--highlight-string, #22863a); }
        .graphql-orm-hl-number { color: var(--highlight-constant, #1750eb); }
        .graphql-orm-hl-masked { color: var(--color-muted, #737373); font-style: italic; }
        .graphql-orm-hl-comment { color: var(--highlight-comment, #6a737d); }
        .graphql-orm-code { margin: 0; max-height: 320px; overflow: auto; white-space: pre-wrap; background: var(--code-block-background, #fafafa); padding: 10px 12px; border-radius: 6px; }
        .graphql-orm-actions { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
        .graphql-orm-error { border-left: 4px solid var(--color-error, #b41939); background: var(--badge-danger-background, #fce9ed); color: var(--badge-danger-color, #83122a); padding: 8px 12px; border-radius: 0 6px 6px 0; }
        .graphql-orm-error pre { max-height: 250px; overflow: auto; }

        .graphql-ast-tree { font-family: var(--font-family-monospace, monospace); background: var(--code-block-background, #fafafa); padding: 12px; border-radius: 6px; }
        .ast-node { margin-left: 12px; }
        .ast-header { cursor: pointer; padding: 2px 6px; border-radius: 4px; display: flex; gap: 8px; align-items: center; }
        .ast-header:hover { background: var(--table-header, #f5f5f5); outline: 1px solid var(--table-border-color, #d4d4d4); }
        .ast-toggle { width: 14px; display: inline-block; user-select: none; }
        .ast-leaf { width: 14px; opacity: .4; }
        .ast-meta { color: var(--color-muted, #737373); font-size: 11px; margin-left: auto; }
        .ast-name { color: var(--color-link, #1d4ed8); }
        .ast-children { margin-left: 18px; border-left: 1px solid var(--table-border-color, #d4d4d4); padding-left: 10px; }
        .ast-node.collapsed > .ast-children { display: none; }
    </style>

    <script>
        function copyToClipboard(button) {
            // The Clipboard API only exists in a secure context (HTTPS or localhost): an application served over plain
            // HTTP, e.g. http://app.docker, copies through a selected textarea instead.
            const copied = navigator.clipboard && window.isSecureContext
                ? navigator.clipboard.writeText(button.dataset.copy)
                : new Promise((resolve, reject) => {
                    const textarea = document.createElement("textarea");
                    textarea.value = button.dataset.copy;
                    textarea.setAttribute("readonly", "");
                    textarea.style.position = "fixed";
                    textarea.style.opacity = "0";
                    document.body.appendChild(textarea);
                    textarea.select();
                    const succeeded = document.execCommand("copy");
                    textarea.remove();
                    succeeded ? resolve() : reject();
                });

            copied
                .then(() => {
                    const original = button.innerText;
                    button.innerText = "Copied ✓";
                    setTimeout(() => {
                        button.innerText = original;
                    }, 1200);
                });
        }

        (() => {
            const panel = document.getElementById("graphql-orm-panel");

            if (!panel) {
                return;
            }

            const selectTab = (name) => {
                panel.querySelectorAll("[data-graphql-orm-tab]").forEach((tab) => {
                    const selected = tab.dataset.graphqlOrmTab === name;
                    tab.classList.toggle("active", selected);
                    tab.setAttribute("aria-selected", String(selected));
                });
                panel.querySelectorAll("[data-graphql-orm-view]").forEach((view) => {
                    view.hidden = view.dataset.graphqlOrmView !== name;
                });
            };

            const toggleRow = (row, open) => {
                const detail = panel.querySelector(`[data-graphql-orm-detail="${row.dataset.graphqlOrmRow}"]`);
                const willOpen = open ?? detail.hidden;
                detail.hidden = !willOpen;
                row.setAttribute("aria-expanded", String(willOpen));
            };

            const applyFilter = () => {
                const filter = panel.querySelector(".graphql-orm-chip[aria-pressed=\"true\"]").dataset.graphqlOrmFilter;
                const term = panel.querySelector(".graphql-orm-search").value.trim().toLowerCase();
                panel.querySelectorAll("[data-graphql-orm-row]").forEach((row) => {
                    const visible = (filter === "all" || row.dataset.graphqlOrmStatus === filter)
                        && (term === "" || row.dataset.graphqlOrmText.includes(term));
                    row.hidden = !visible;
                    if (!visible) {
                        toggleRow(row, false);
                    }
                });
            };

            const openQuery = (number) => {
                selectTab("queries");
                const row = panel.querySelector(`[data-graphql-orm-row="${number}"]`);
                if (row) {
                    toggleRow(row, true);
                    row.scrollIntoView({ block: "center" });
                }
            };

            panel.addEventListener("click", (event) => {
                const tab = event.target.closest("[data-graphql-orm-tab]");
                const goto = event.target.closest("[data-graphql-orm-goto]");
                const open = event.target.closest("[data-graphql-orm-open]");
                const chip = event.target.closest("[data-graphql-orm-filter]");
                const subtab = event.target.closest("[data-graphql-orm-subtab]");
                const row = event.target.closest("[data-graphql-orm-row]");

                if (tab || goto) {
                    event.preventDefault();
                    selectTab((tab ?? goto).dataset[tab ? "graphqlOrmTab" : "graphqlOrmGoto"]);
                } else if (open) {
                    event.preventDefault();
                    openQuery(open.dataset.graphqlOrmOpen);
                } else if (chip) {
                    panel.querySelectorAll("[data-graphql-orm-filter]").forEach((other) => other.setAttribute("aria-pressed", String(other === chip)));
                    applyFilter();
                } else if (subtab) {
                    const box = subtab.closest(".graphql-orm-detail-box");
                    box.querySelectorAll("[data-graphql-orm-subtab]").forEach((other) => other.setAttribute("aria-selected", String(other === subtab)));
                    box.querySelectorAll("[data-graphql-orm-pane]").forEach((pane) => {
                        pane.hidden = pane.dataset.graphqlOrmPane !== subtab.dataset.graphqlOrmSubtab;
                    });
                } else if (row && !event.target.closest("a, button, input")) {
                    toggleRow(row);
                }
            });

            panel.addEventListener("keydown", (event) => {
                const row = event.target.closest("[data-graphql-orm-row]");
                if (row && event.target === row && (event.key === "Enter" || event.key === " ")) {
                    event.preventDefault();
                    toggleRow(row);
                }
            });

            panel.querySelector(".graphql-orm-search").addEventListener("input", applyFilter);

            // A query in error is shown open: it is what the page was opened for.
            const failed = panel.querySelector("[data-graphql-orm-status=\"error\"]");
            if (failed) {
                toggleRow(failed, true);
            }

            const hash = window.location.hash.match(/^#graphql-orm-query-(\d+)$/);
            if (hash) {
                openQuery(hash[1]);
            }
        })();

        document.addEventListener("click", (e) => {
            const header = e.target.closest(".ast-header")

            if (!header) {
                return
            }

            const node = header.parentElement

            const children = node.querySelector(":scope > .ast-children")

            if (!children) {
                return
            }
            node.classList.toggle("collapsed")

            const toggle = header.querySelector(".ast-toggle")

            if (toggle) {
                toggle.innerText = node.classList.contains("collapsed") ? "▶" : "▼"
            }
        })
    </script>
{% endblock %}

{# ================= MACROS ================= #}

{% macro renderValue(value) %}
    {%- if value is same as(true) -%}
        true
    {%- elseif value is same as(false) -%}
        false
    {%- elseif value is null -%}
        <span class="graphql-orm-muted">-</span>
    {%- elseif value is iterable -%}
        {%- if value is empty -%}
            <span class="graphql-orm-muted">-</span>
        {%- else -%}
            {%- for key, item in value -%}{{ key matches '/^\\d+$/' ? '' : key ~ ': ' }}{{ _self.renderValue(item) }}{{ loop.last ? '' : ', ' }}{%- endfor -%}
        {%- endif -%}
    {%- else -%}
        <code>{{ value }}</code>
    {%- endif -%}
{% endmacro %}

{% macro originKind(origin) %}{{ origin in ['lazy', 'introspection'] ? origin : (origin in ['count', 'sum', 'avg', 'min', 'max'] ? 'count' : 'query') }}{% endmacro %}

{% macro renderOrigin(query) %}
    {% if query.origin ?? null %}
        <span class="graphql-orm-origin graphql-orm-origin-{{ _self.originKind(query.origin)|trim }}">{{ query.origin }}</span>
        {% if (query.result_cache ?? null) == 'hit' %}<span class="graphql-orm-origin graphql-orm-origin-count" title="Answered by the result cache, without being sent">result cache</span>{% endif %}
        {% if query.from_cached_entity ?? false %}<span class="graphql-orm-origin graphql-orm-origin-lazy" title="A relation of an entity read from the second-level cache">from cached entity</span>{% endif %}
        {% if query.during_serialization ?? false %}<span class="graphql-orm-origin graphql-orm-origin-lazy" title="Sent while the serializer was writing an entity">serializer</span>{% endif %}
        {% if query.sub_request ?? null %}<span class="graphql-orm-origin graphql-orm-origin-introspection" title="Sent by a sub-request (a fragment, a forward), whose own profile holds it as well">sub-request {{ query.sub_request }}</span>{% endif %}
        {% if query.after_response ?? false %}<span class="graphql-orm-origin graphql-orm-origin-lazy" title="Sent once the response was sent: by a kernel.terminate listener, or a streamed response">after the response</span>{% endif %}
    {% else %}
        <span class="graphql-orm-muted">-</span>
    {% endif %}
{% endmacro %}

{# A trigger of the second-level cache with a short class name: lazy load of Task::$label #}
{% macro shortTrigger(trigger) %}
    {%- set lazyLoadOf = 'lazy load of ' -%}
    {{- trigger starts with lazyLoadOf ? lazyLoadOf ~ (trigger|slice(lazyLoadOf|length)|split('\\')|last) : trigger -}}
{% endmacro %}

{% macro renderDetail(query, number, resultCachePool) %}
    <div class="graphql-orm-detail-box">
        {% for error in query.errors ?? [] %}
            <div class="graphql-orm-error">
                <strong>{{ error.message }}</strong>
                {% if error.extensions.code ?? null %}
                    <br><small>Code: {{ error.extensions.code }}</small>
                {% endif %}
                {% if error.extensions.exception.stacktrace ?? null %}
                    <details>
                        <summary>Stacktrace</summary>
                        <pre>{{ error.extensions.exception.stacktrace|join("\n") }}</pre>
                    </details>
                {% endif %}
            </div>
        {% endfor %}

        <div class="graphql-orm-subtabs" role="tablist" aria-label="Query #{{ number }}">
            <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="true" data-graphql-orm-subtab="graphql">GraphQL</button>
            <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="false" data-graphql-orm-subtab="variables">Variables</button>
            {% if query.response_preview ?? null %}
                <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="false" data-graphql-orm-subtab="response">Response</button>
            {% endif %}
            {% if query.ast %}
                <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="false" data-graphql-orm-subtab="ast">AST</button>
            {% endif %}
            <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="false" data-graphql-orm-subtab="hydration">Hydration</button>
            {% if query.result_cache ?? null %}
                <button type="button" class="graphql-orm-subtab" role="tab" aria-selected="false" data-graphql-orm-subtab="cache">Cache</button>
            {% endif %}
        </div>

        <div data-graphql-orm-pane="graphql">
            <pre class="graphql-orm-code">{{ query.graphql|graphql_orm_highlight }}</pre>
        </div>
        <div data-graphql-orm-pane="variables" hidden>
            {% if query.variables %}
                {{ dump(query.variables) }}
            {% else %}
                <p class="graphql-orm-muted">No variables: the values are written in the query.</p>
            {% endif %}
        </div>
        {% if query.response_preview ?? null %}
            <div data-graphql-orm-pane="response" hidden>
                <pre class="graphql-orm-code">{{ query.response_preview }}</pre>
                <p class="graphql-orm-muted">The first 2 KB of {{ (query.response_size / 1024)|number_format(1) }} KB, values masked unless <code>redact_query_values</code> is false.</p>
            </div>
        {% endif %}
        {% if query.ast %}
            <div data-graphql-orm-pane="ast" hidden>
                <div class="graphql-ast-tree">
                    {{ _self.renderAst(query.ast, 0) }}
                </div>
            </div>
        {% endif %}
        {% if query.result_cache ?? null %}
            <div data-graphql-orm-pane="cache" hidden>
                <table>
                    <tbody>
                        <tr>
                            <th>Outcome</th>
                            <td>{{ query.result_cache == 'hit' ? 'hit: answered without being sent' : 'miss: sent, its response kept' }}</td>
                        </tr>
                        <tr>
                            <th>Key</th>
                            <td>{% if query.result_cache_key ?? null %}<code>{{ query.result_cache_key }}</code>{% else %}derived from the query and its variables{% endif %}</td>
                        </tr>
                        <tr>
                            <th>Lifetime</th>
                            <td>{{ (query.result_cache_lifetime ?? null) is not null ? query.result_cache_lifetime ~ ' s' : 'the default lifetime of the pool' }}</td>
                        </tr>
                        <tr>
                            <th>Pool</th>
                            <td>{% if resultCachePool %}<code>{{ resultCachePool }}</code>{% else %}-{% endif %}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endif %}
        <div data-graphql-orm-pane="hydration" hidden>
            <table>
                <tbody>
                    <tr>
                        <th>Hydrated as</th>
                        <td>
                            {% if query.hydrated_as ?? null %}
                                DTO <code>{{ query.hydrated_as }}</code>, created through its constructor with <code>hydrateAs()</code>: neither identity map, nor second-level cache, nor lazy loading
                            {% else %}
                                entities
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Relations loaded</th>
                        <td>
                            {% if query.with ?? [] is not empty %}
                                {% for path in query.with %}<code>{{ path }}</code>{{ not loop.last ? ', ' }}{% endfor %}, named by <code>with()</code>
                            {% else %}
                                up to <code>max_depth</code>
                            {% endif %}
                        </td>
                    </tr>
                    <tr><th>Time</th><td>{{ (query.hydration_duration ?? 0)|number_format(1) }} ms, apart from the {{ query.duration|number_format(1) }} ms of the network</td></tr>
                    <tr><th>Entities</th><td>{{ query.hydrated_entities }}</td></tr>
                    <tr><th>Relations</th><td>{{ query.hydrated_relations }}</td></tr>
                    <tr><th>Collections</th><td>{{ query.hydrated_collections }}</td></tr>
                    <tr><th>Root result count</th><td>{{ query.hydrated_count }}{% if query.index_by ?? null %}, indexed by <code>{{ query.index_by }}</code>{% endif %}</td></tr>
                    <tr><th>Depth used</th><td>{{ query.depth_used }}</td></tr>
                </tbody>
            </table>
            {% if query.collections ?? [] is not empty %}
                <table>
                    <thead>
                        <tr><th>Collection</th><th>Type</th><th class="graphql-orm-number">Hydrated</th><th class="graphql-orm-number">Items</th></tr>
                    </thead>
                    <tbody>
                        {% for collection in query.collections %}
                            <tr>
                                <td><code title="{{ collection.relation }}">{{ collection.relation|split('\\')|last }}</code></td>
                                <td title="{{ collection.type }}">{{ collection.type|split('\\')|last }}</td>
                                <td class="graphql-orm-number">{{ collection.collections }}</td>
                                <td class="graphql-orm-number">{{ collection.items }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        <div class="graphql-orm-actions">
            <button type="button" class="btn btn-sm" onclick="copyToClipboard(this)" data-copy="{{ query.graphql|e('html_attr') }}">Copy</button>
            {% if query.curl is defined and query.curl %}
                <button type="button" class="btn btn-sm" onclick="copyToClipboard(this)" data-copy="{{ query.curl|e('html_attr') }}"
                        title="Values are masked unless redact_query_values is false; headers such as Authorization are not included.">
                    Copy as cURL
                </button>
            {% endif %}
            {% if query.caller %}
                <span class="graphql-orm-muted" title="{{ query.caller.file }}">
                    Called from <code>{{ query.caller.file|split('/')|last }}:{{ query.caller.line }}</code>
                    {% if query.caller.class %}{{ query.caller.class }}::{{ query.caller.function }}(){% endif %}
                </span>
            {% endif %}
            {% if query.endpoint %}
                <span class="graphql-orm-muted">POST {{ query.endpoint }}</span>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro renderAst(node, depth) %}
    {% import _self as self %}
    {% if node.operation is defined %}
        <div class="ast-node ast-root">
            <div class="ast-header open">
                <span class="ast-toggle">▼</span>
                <strong>{{ node.operation }}</strong>
                <span class="ast-meta">
                    [depth: {{ depth }} | fields: {{ node.fields|length }}]
                </span>
            </div>
            <div class="ast-children">
                {% for field in node.fields %}
                    {{ self.renderAst(field, depth + 1) }}
                {% endfor %}
            </div>
        </div>
    {% else %}
        {% set hasChildren = node.selectionSet and node.selectionSet.fields|length > 0 %}
        <div class="ast-node">
            <div class="ast-header {{ hasChildren ? 'open' : '' }}">
                {% if hasChildren %}
                    <span class="ast-toggle">▼</span>
                {% else %}
                    <span class="ast-leaf">•</span>
                {% endif %}
                <span class="ast-name">
                    {{ node.name }}
                    {% if node.arguments is defined and node.arguments %}
                        (
                        {% for k,v in node.arguments %}
                            {{ k }}={{ v|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                        )
                    {% endif %}
                </span>
                {% if hasChildren %}
                    <span class="ast-meta">
                        [depth: {{ depth }} | fields: {{ node.selectionSet.fields|length }}]
                    </span>
                {% endif %}
            </div>
            {% if hasChildren %}
                <div class="ast-children">
                    {% for child in node.selectionSet.fields %}
                        {{ self.renderAst(child,depth + 1) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}
