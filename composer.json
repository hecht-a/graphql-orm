{
    "name": "hecht-a/graphql-orm",
    "description": "GraphQL ORM for Symfony",
    "type": "symfony-bundle",
    "keywords": ["graphql"],
    "homepage": "https://github.com/hecht-a/graphql-orm",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "GraphqlOrm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GraphqlOrm\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "HECHT Axel",
            "email": "axel.hct@gmail.com",
            "homepage": "https://github.com/hecht-a"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/stopwatch": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/type-info": "^7.4 || ^8.0",
        "symfony/string": "^7.4 || ^8.0",
        "phpstan/phpdoc-parser": "^2.2",
        "symfony/cache-contracts": "^3.5"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^8.0",
        "phpunit/phpunit": "^12.5",
        "symfony/cache": "^7.4.8 || ^8.0.8",
        "phpstan/phpstan": "^2.2",
        "twig/twig": "^3.20",
        "symfony/form": "^7.4 || ^8.0",
        "phpbench/phpbench": "^1.7",
        "symfony/serializer": "^7.4 || ^8.0",
        "doctrine/collections": "^2.2 || ^3.0",
        "doctrine/persistence": "^3.0 || ^4.0"
    },
    "suggest": {
        "phpstan/extension-installer": "Enables the PHPStan rules checking field names (extension.neon)",
        "doctrine/collections": "Hydrates the relations whose property is typed Collection as an ArrayCollection",
        "doctrine/orm": "References GraphQL entities from Doctrine entities (#[GraphqlReference])",
        "symfony/form": "Enables GraphqlEntityType, a form field whose choices are entities",
        "symfony/serializer": "Writes the entities without loading their lazy relations (GraphqlEntityNormalizer)"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
