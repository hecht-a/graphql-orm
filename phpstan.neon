parameters:
	level: max
	paths:
		- src/
		- tests/
	excludePaths:
		- src/Resources/stubs/*
		# Loaded by the routing of the application: symfony/routing is no dependency of the bundle
		- src/Resources/config/routes.php
		# Code analysed by the tests of the bundle rules, with deliberate errors
		- tests/PHPStan/data/*

	tmpDir: cache
services:
	# The extension the bundle gives the applications for their mapped properties, applied to its own fixtures
	-
		class: GraphqlOrm\PHPStan\MappedPropertiesExtension
		tags: [phpstan.properties.readWriteExtension]
